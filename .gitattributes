# Normalize source and documentation line endings while preserving UTF-8 bytes.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf

# Binary point clouds, mappings, meshes, images and reports are never rewritten.
*.ply binary
*.npz binary
*.npy binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
